{
  "info": {
    "name": "ShopExpress",
    "description": "Pruebas de la API de ShopExpress. Cada solicitud verifica su resultado con tests.\n\nLas carpetas se corren en orden: algunas solicitudes usan el id que guardó una anterior.\n\nDesde la raíz del repositorio:\n\n```\nnpx newman run postman/ShopExpress.postman_collection.json -e postman/ShopExpress.postman_environment.json\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario con una dirección",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Valores nuevos en cada corrida: el email y el documento son únicos.",
                  "pm.collectionVariables.set(\"runId\", Date.now().toString(36));",
                  "pm.collectionVariables.set(\"documentNumber\", String(Math.floor(10000000 + Math.random() * 90000000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.response.json();",
                  "pm.test(\"Responde 201 con un id usr_\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(user.id).to.match(/^usr_/);",
                  "});",
                  "pm.test(\"Devuelve los datos enviados y la dirección\", () => {",
                  "    pm.expect(user.firstName).to.eql(\"Juan\");",
                  "    pm.expect(user.email).to.eql(\"juan.perez.\" + pm.collectionVariables.get(\"runId\") + \"@example.com\");",
                  "    pm.expect(user.addresses).to.have.length(1);",
                  "    pm.expect(user.addresses[0].city).to.eql(\"Montevideo\");",
                  "});",
                  "pm.test(\"El header Location apunta al usuario\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/users/\" + user.id + \"$\"));",
                  "});",
                  "pm.collectionVariables.set(\"userId\", user.id);",
                  "pm.collectionVariables.set(\"createdUser\", JSON.stringify(user));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usersUrl}}/api/users",
            "description": "CA-01. Los datos únicos llevan un sufijo aleatorio para que la colección se pueda correr varias veces.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"CI\",\n  \"documentNumber\": \"{{documentNumber}}\",\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Pérez\",\n  \"email\": \"juan.perez.{{runId}}@example.com\",\n  \"addresses\": [\n    {\n      \"street\": \"Av. Principal 123\",\n      \"city\": \"Montevideo\",\n      \"postalCode\": \"11000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar el usuario creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con los mismos datos que el alta\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get(\"createdUser\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/users/{{userId}}",
            "description": "CA-01: el GET devuelve los mismos campos y direcciones que el alta."
          }
        },
