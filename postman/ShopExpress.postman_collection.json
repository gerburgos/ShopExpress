              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "pm.test(\"Responde 201 con un id prod_\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(product.id).to.match(/^prod_/);",
                  "});",
                  "pm.test(\"Devuelve los datos, el stock y el precio con dos decimales\", () => {",
                  "    pm.expect(product.name).to.eql(\"Mate de calabaza\");",
                  "    pm.expect(product.categories).to.eql([\"hogar\", \"regionales\"]);",
                  "    pm.expect(product.stock).to.eql(10);",
                  "    pm.expect(pm.response.text()).to.include('\"price\":25.50');",
                  "});",
                  "pm.test(\"El header Location apunta al producto\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/products/\" + product.id + \"$\"));",
                  "});",
                  "pm.collectionVariables.set(\"productId\", product.id);",
                  "pm.collectionVariables.set(\"createdProduct\", JSON.stringify(product));"
                ]
              }
            }
          ],
