        {
          "name": "Agregar la dirección número 11",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El usuario tiene 2 direcciones: se agregan 8 para llegar al máximo de 10.",
                  "const url = pm.variables.replaceIn(\"{{usersUrl}}/api/users/{{userId}}/addresses\");",
                  "for (let i = 3; i <= 10; i++) {",
                  "    pm.sendRequest({",
                  "        url: url,",
                  "        method: \"POST\",",
                  "        header: [{ key: \"Content-Type\", value: \"application/json\" }],",
                  "        body: { mode: \"raw\", raw: JSON.stringify({ street: \"Calle \" + i, city: \"Montevideo\", postalCode: \"11000\" }) }",
                  "    }, (err, res) => {",
                  "        if (err || res.code !== 201) {",
                  "            console.error(\"No se pudo agregar la dirección \" + i, err || res.code);",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 422 con el código ADDRESS_LIMIT_REACHED\", () => {",
